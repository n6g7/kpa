/CLAUDE.local.md

/target

# Generated by tests/fixture.sh — throwaway .kdbx files built fresh for
# each test run, never committed.
/tests/fixtures

# direnv's per-project cache (the .envrc itself is committed).
/.direnv

# A local config, e.g. `cp config.example.toml config.toml` pointed at a
# real vault. The example is committed; anything naming an actual database
# path is not.
/config.toml

# Security audit reports (the security-audit skill). Kept out of the public
# repo while they describe unfixed findings.
/docs/audits/
